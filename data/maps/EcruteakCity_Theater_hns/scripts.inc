	.string "¿Me estás diciendo que no\n"
	.string "respetas lo que el cliente te\l"
	.string "está pidiendo?$"
EcruteakCity_Theater_Text_Rocket3:
	.string "¡Pues entonces te voy a enseñar\n"
	.string "yo cómo se baila de verdad!\p"
