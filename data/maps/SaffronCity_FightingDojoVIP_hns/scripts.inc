SaffronCity_FightingDojoVIP_EvetScript_Statue::
	msgbox SaffronCity_FightingDojoVIP_Text_Statue, MSGBOX_SIGN
	end

SaffronCity_FightingDojoVIP_Text_Statue:
	.string "SALA VIP DEL DOJO KARATE$"

SaffronCity_FightingDojoVIP_Text_Falkner_Rematch:
	.string "¡Enhorabuena por derrotar al\n"
	.string "ALTO MANDO!\p"
	.string "He entrenado aún más duro a mis\n"
	.string "POKéMON de tipo VOLADOR.\p"
	.string "¿Podrás volver a enfrentarte al\n"
	.string "poder de los cielos?$"

SaffronCity_FightingDojoVIP_Text_Falkner_RematchDefeat:
	.string "Uau… Has vuelto a vencerme.\p"
	.string "¡Entrenaré más para convertirme\n"
	.string "en el mejor maestro de aves!$"

SaffronCity_FightingDojoVIP_Text_Bugsy_Rematch:
	.string "¡Uau, ahora eres CAMPEÓN de\n"
	.string "JOHTO!\p"
	.string "¡Tu habilidad es impresionante!\p"
	.string "He estado investigando mucho.\p"
	.string "Quiero mostrarte mis nuevos\n"
	.string "descubrimientos.\p"
	.string "¿Quieres volver a combatir?$"

SaffronCity_FightingDojoVIP_Text_Bugsy_RematchDefeat:
	.string "Uau, debes de ser un entrenador\n"
	.string "experto.\p"
	.string "Mi investigación aún no debe de\n"
	.string "estar completa…$"

SaffronCity_FightingDojoVIP_Text_Whitney_Rematch:
	.string "¡Hola! ¡Eres tú!\p"
	.string "¿Ahora eres CAMPEÓN de JOHTO?\p"
	.string "¡Eres increíble de verdad!\p"
	.string "Quiero ver lo fuerte que eres.\p"
	.string "¿Quieres volver a combatir?$"

SaffronCity_FightingDojoVIP_Text_Whitney_RematchDefeat:
	.string "Waaaaah!\p"
	.string "Waaaaah!\p"
	.string "Snif, hip… ¡Qué cruel eres!$"

SaffronCity_FightingDojoVIP_Text_Morty_Rematch:
	.string "¡Ah, el CAMPEÓN de JOHTO!\p"
	.string "Me alegra que hayas venido.\p"
	.string "Has demostrado fuerza y talento,\n"
	.string "pero ¿has mejorado desde nuestro\l"
	.string "último combate?\p"
	.string "He entrenado con mis POKéMON de\n"
	.string "tipo FANTASMA.\p"
	.string "Veamos si vuelves a superar las\n"
	.string "sombras.\p"
	.string "¿Quieres volver a combatir?$"

SaffronCity_FightingDojoVIP_Text_Morty_RematchDefeat:
	.string "Aún no soy lo bastante bueno…\p"
	.string "Has presenciado mucho más que yo.\p"
	.string "Te envidio por ello…$"

SaffronCity_FightingDojoVIP_Text_Chuck_Rematch:
	.string "¡JA, JA, JA! ¡CAMPEÓN de JOHTO!\p"
	.string "¡Has vuelto a por más!\p"
	.string "¡Veo que has mejorado!\p"
	.string "¿Listo para ver quién es\n"
	.string "más fuerte?$"

SaffronCity_FightingDojoVIP_Text_Chuck_RematchDefeat:
	.string "¿Qué? ¿He perdido? ¿Otra vez?$"

SaffronCity_FightingDojoVIP_Text_Jasmine_Rematch:
	.string "Enhorabuena, CAMPEÓN de JOHTO.\p"
	.string "Te has vuelto muy fuerte…\p"
	.string "Me pregunto si habré mejorado.\p"
	.string "¿Te gustaría comprobarlo?\p"
	.string "¿Quieres volver a combatir?$"

SaffronCity_FightingDojoVIP_Text_Jasmine_RematchDefeat:
	.string "Eres mejor entrenando que yo,\n"
	.string "tanto en destreza como en bondad.$"

SaffronCity_FightingDojoVIP_Text_Pryce_Rematch:
	.string "¡Ah, CAMPEÓN de JOHTO!\p"
	.string "Tu destreza es extraordinaria.\p"
	.string "Estoy impresionado.\p"
	.string "Pero aún podemos aprender mucho\n"
	.string "el uno del otro.\p"
	.string "Yo, FREDO, entrenador invernal,\n"
	.string "aún guardo algún truco.\p"
	.string "¿Quieres volver a combatir?$"

SaffronCity_FightingDojoVIP_Text_Pryce_RematchDefeat:
	.string "Una vez más, me impresiona tu\n"
	.string "destreza.\p"
	.string "Con tu férrea voluntad superarás\n"
	.string "todos los obstáculos de la vida.$"

SaffronCity_FightingDojoVIP_Text_Clair_Rematch:
	.string "Lo conseguiste, ¿eh?\p"
	.string "Ahora eres CAMPEÓN de JOHTO.\p"
	.string "Has demostrado tu fuerza, pero\n"
	.string "¿podrás volver a vencerme?\p"
	.string "Como maestra dragón, no pienso\n"
	.string "contenerme.\p"
	.string "Esta vez no.\p"
	.string "¿Quieres volver a combatir?$"

SaffronCity_FightingDojoVIP_Text_Clair_RematchDefeat:
	.string "¿He perdido?\p"
	.string "¿Otra vez?\p"
	.string "No me lo creo. Debe de haber\n"
	.string "algún error…$"

SaffronCity_FightingDojoVIP_Text_Brock_Rematch:
	.string "BROCK: ¡Hola, {PLAYER}!\p"
	.string "He oído que ahora eres CAMPEÓN\n"
	.string "de KANTO.\p"
	.string "¡Es increíble!\p"
	.string "Ahora debes de ser más fuerte.\p"
	.string "¿Quieres volver a combatir?$"

SaffronCity_FightingDojoVIP_Text_Brock_RematchDefeat:
	.string "BROCK: Tus POKéMON han vuelto a\n"
	.string "superar mi defensa pétrea…$"

SaffronCity_FightingDojoVIP_Text_Misty_Rematch:
	.string "MISTY: ¡Uau, ahora eres CAMPEÓN\n"
	.string "de KANTO!\p"
	.string "¡Es increíble! Has llegado lejos,\n"
	.string "{PLAYER}.\p"
	.string "Pero no pienso echarme atrás.\p"
	.string "¿Quieres volver a combatir?$"

SaffronCity_FightingDojoVIP_Text_Misty_RematchDefeat:
	.string "MISTY: De verdad que eres bueno…$"

SaffronCity_FightingDojoVIP_Text_Surge_Rematch:
	.string "SURGE: ¡Ahora eres CAMPEÓN de\n"
	.string "KANTO!\p"
	.string "¡Impresionante, chaval! ¡Pero no\n"
	.string "creas que he terminado!\p"
	.string "¿Qué tal otro combate?$"

SaffronCity_FightingDojoVIP_Text_Surge_RematchDefeat:
	.string "SURGE: ¡Arrrgh! ¡Sigues siendo\n"
	.string "igual de fuerte!$"

SaffronCity_FightingDojoVIP_Text_Erika_Rematch:
	.string "ERIKA: Ah, hola.\p"
	.string "¡Qué sorpresa, CAMPEÓN!\p"
	.string "Me alegra mucho volver a verte.\p"
	.string "Tu viaje habrá sido emocionante.\p"
	.string "Hasta los campeones disfrutan\n"
	.string "de un desafío.\p"
	.string "¿Quieres volver a combatir?$"

SaffronCity_FightingDojoVIP_Text_Erika_RematchDefeat:
	.string "ERIKA: Perder aún deja un\n"
	.string "regusto amargo…\p"
	.string "Pero conocer entrenadores fuertes\n"
	.string "me anima a mejorar…$"

SaffronCity_FightingDojoVIP_Text_Sabrina_Rematch:
	.string "SABRINA: Ah, el CAMPEÓN.\p"
	.string "Percibí tu regreso.\p"
	.string "Tu poder ha crecido muchísimo.\p"
	.string "Incluso ahora siento tu aura.\p"
	.string "¿Quieres volver a combatir?$"

SaffronCity_FightingDojoVIP_Text_Sabrina_RematchDefeat:
	.string "SABRINA: Tu amor por tus POKéMON\n"
	.string "ha vuelto a superar mi poder\l"
	.string "psíquico…$"

SaffronCity_FightingDojoVIP_Text_Janine_Rematch:
	.string "Je, je, je…\p"
	.string "¡Uau, lo conseguiste!\p"
	.string "¡Ahora eres CAMPEÓN!\p"
	.string "¡Estoy muy orgullosa! Pero no\n"
	.string "creas que seré blanda contigo.\p"
	.string "¿Quieres volver a combatir?$"

SaffronCity_FightingDojoVIP_Text_Janine_RematchDefeat:
	.string "SACHIKO: ¡Sigues siendo igual de\n"
	.string "fuerte!\p"
	.string "Has ganado sin ninguna duda…$"

SaffronCity_FightingDojoVIP_Text_Blaine_Rematch:
	.string "BLAINE: ¡Uau!\p"
	.string "¡Veo que te has convertido en\n"
	.string "CAMPEÓN de KANTO!\p"
	.string "¡Eso sí que arde!\p"
	.string "Tu destreza es de primera.\p"
	.string "Siempre estoy listo para luchar.\p"
	.string "¿Quieres volver a combatir?$"

SaffronCity_FightingDojoVIP_Text_Blaine_RematchDefeat:
	.string "BLAINE: ¡Tu destreza sí que es\n"
	.string "ardiente!\p"
	.string "Has reducido mis defensas a\n"
	.string "cenizas.$"

SaffronCity_FightingDojoVIP_Text_Blue_Rematch:
	.string "BLUE: Vaya, vaya. ¡CAMPEÓN!\p"
	.string "Parece que has llegado muy lejos.\p"
	.string "Yo también tuve ese título, ¿sabes?\p"
	.string "Pero no seré blando contigo.\p"
	.string "Veamos si mantienes el nivel.\p"
	.string "¿Quieres volver a combatir?$"

SaffronCity_FightingDojoVIP_Text_Blue_RematchDefeat:
	.string "BLUE: ¿Qué?\p"
	.string "¿Cómo demonios he vuelto a perder?$"
